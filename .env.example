# Copie para Simcag.IngestionService.Api/.env (DotNetEnv.NoClobber().Load()).
#
# Docker + infra no anfitrião: RABBITMQ__HOST=host.docker.internal, guest/guest (docker-compose.dev.yml)
# ASPNETCORE_URLS=http://+:8080, ASPNETCORE_HTTP_PORTS=8080

# RabbitMQ (host e user são validados no arranque)
RABBITMQ__HOST=localhost
RABBITMQ__PORT=5672
RABBITMQ__USERNAME=guest
RABBITMQ__PASSWORD=guest
RABBITMQ__VIRTUALHOST=/
# RABBITMQ__EVENTS_EXCHANGE=events

# Porta de escuta (opcional; o Program também tenta ASPNETCORE_URLS e faixa de portos livres)
# ASPNETCORE_URLS=http://0.0.0.0:8080
# PORT=8080
